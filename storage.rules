rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /closings/{closingId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.metadata.ownerId == request.auth.uid
        && request.resource.metadata.closingId == closingId
        && (request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf');
      allow delete: if request.auth != null
        && (request.auth.token.email == 'glleucedias1@gmail.com'
          || resource.metadata.ownerId == request.auth.uid);
      allow update: if false;
    }
  }
}
