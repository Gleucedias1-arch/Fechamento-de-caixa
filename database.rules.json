{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'glleucedias1@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (auth.token.email === 'glleucedias1@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "newData.hasChildren(['name','email','role','active']) && (newData.child('role').val() === 'admin' || newData.child('role').val() === 'finance' || newData.child('role').val() === 'manager' || newData.child('role').val() === 'operator')"
      }
    },
    "settings": {
      ".read": "auth != null && (auth.token.email === 'glleucedias1@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'finance')",
      ".write": "auth != null && (auth.token.email === 'glleucedias1@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'finance')",
      "cardFeeRates": {
        "$machine": {
          "credit": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "debit": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "pix": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "divergenceTolerance": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('active').val() === true",
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
      }
    },
    "closings": {
      ".read": "auth != null && (auth.token.email === 'glleucedias1@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'finance' || (root.child('users').child(auth.uid).child('active').val() === true && query.orderByChild === 'store' && query.equalTo === root.child('users').child(auth.uid).child('store').val()))",
      ".indexOn": [
        "date",
        "store",
        "searchDateStore",
        "financeStatus"
      ],
      "$id": {
        ".write": "auth != null && (auth.token.email === 'glleucedias1@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin' || (root.child('users').child(auth.uid).child('active').val() === true && root.child('users').child(auth.uid).child('store').val() === newData.child('store').val() && newData.child('createdBy').val() === auth.uid && (!data.exists() || data.child('status').val() === 'draft' || data.child('status').val() === 'returned') && !newData.child('financeReview').exists() && (newData.child('status').val() === 'draft' || newData.child('status').val() === 'submitted')))",
        ".validate": "newData.hasChildren(['id','date','store','operator','systemTotal','countedTotal','difference','status','createdBy','financeStatus']) && newData.child('id').val() === $id && (!data.exists() || newData.child('createdBy').val() === data.child('createdBy').val()) && (!data.exists() || newData.child('createdAt').val() === data.child('createdAt').val())",
        "id": {
          ".validate": "newData.isString() && newData.val() === $id"
        },
        "date": {
          ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)"
        },
        "store": {
          ".validate": "newData.val() === 'House 190 Teixeira' || newData.val() === 'House 190 Eunápolis' || newData.val() === 'House Food Park Teixeira'"
        },
        "shift": {
          ".validate": "!newData.exists() || newData.val() === 'Noite' || newData.val() === 'Almoço' || newData.val() === 'Integral'"
        },
        "status": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'finance' && root.child('closings').child($id).child('status').val() !== 'approved' && (newData.val() === 'approved' || newData.val() === 'returned')",
          ".validate": "newData.val() === 'draft' || newData.val() === 'submitted' || newData.val() === 'approved' || newData.val() === 'returned' || newData.val() === 'reopened'"
        },
        "financeStatus": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'finance' && root.child('closings').child($id).child('status').val() !== 'approved' && (newData.val() === 'approved' || newData.val() === 'returned')",
          ".validate": "newData.val() === 'not_submitted' || newData.val() === 'pending' || newData.val() === 'approved' || newData.val() === 'returned' || newData.val() === 'reopened'"
        },
        "financeReview": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'finance' && root.child('closings').child($id).child('status').val() !== 'approved'",
          ".validate": "!newData.exists() || auth.token.email === 'glleucedias1@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'finance'"
        },
        "locked": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'finance'",
          ".validate": "newData.isBoolean()"
        },
